# deploy/.env — 개발서버별 값. 이 파일을 .env로 복사해 채운다 (.env는 git 미추적).

# 필수 — 브라우저가 도달하는 개발서버 주소(IP 또는 호스트명). MediaMTX WebRTC ICE 후보에 들어간다
VCA_HOST=10.0.0.10
# 필수 — 카메라 자격증명·SMTP 비밀번호 AES-256 키 원문. 한 번 정하면 바꾸지 않는다 (바꾸면 기존 암호문 복호화 불가)
VCA_ADMIN_ENC_KEY=change-me-long-random
# 필수 — 초기 owner(admin@univs.ai) 임시 비밀번호. 첫 로그인 후 반드시 변경
VCA_ADMIN_SEED_PASSWORD=change-me-Owner1234!
# 권장
POSTGRES_PASSWORD=change-me-db

# 사이트/모듈
VCA_SITE_ID=sg
# 실제 분석 모듈이 준비되면 그 주소로 (sim 서비스는 빼고 기동: docker compose up -d --scale sim=0)
# VCA_MODULE_API_BASE_URL=http://module-host:8081/v1
SIM_TOGGLE_P=0.15

# 포트 (호스트에 여는 것) — 앞에 127.0.0.1: 을 붙이면 로컬 전용
HTTP_PORT=80
PROXY_PORT=8080
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=127.0.0.1:18083
RTSP_PORT=8554
WEBRTC_UDP_PORT=8189
# 브라우저 MQTT WebSocket 주소 — 비우면 ws://{접속 호스트}:8083/mqtt. EMQX_WS_PORT를 바꿨으면 지정
VCA_MQTT_WS_URL=

# 개발서버 전용 스위치 — 운영에서는 반드시 바꿀 것
VCA_COOKIE_SECURE=false          # TLS 앞단(리버스 프록시)이 생기면 true
VCA_ADMIN_MAIL_DEV_LOG=true      # SMTP 없음: 재설정 코드를 admin 로그에 남김. 운영 false
VCA_ADMIN_SEED_CAMERAS=true      # 시드 카메라 8대(test-stream). 실카메라 등록 시 false

VCA_IMAGE_PREFIX=vca
VCA_IMAGE_TAG=dev
