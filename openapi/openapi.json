{
  "openapi": "3.0.3",
  "info": {
    "title": "VCA API",
    "version": "0.0.0",
    "description": "백엔드가 생성/관리하는 API 계약. 프론트는 orval(npm run gen:api)로 이 스펙에서 타입/훅을 생성한다."
  },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/users": {
      "get": {
        "operationId": "getUsers",
        "summary": "사용자 목록 조회",
        "tags": ["users"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserListResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "name", "email"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "UserListResponse": {
        "type": "object",
        "required": ["success", "code", "data"],
        "properties": {
          "success": { "type": "boolean" },
          "code": { "type": "string" },
          "message": { "type": "string", "nullable": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/User" }
          }
        }
      }
    }
  }
}
