        "responses": {
          "200": {
            "description": "삭제됨 (data: null)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/admin/api/provision/sync": {
      "post": {
        "operationId": "syncProvision",
        "summary": "수동 재동기화 (모듈 provisioning + 미디어 서버 path)",
        "tags": ["provision"],
        "responses": {
          "200": {
            "description": "OK — synced가 false면 둘 중 하나 이상 미응답 (원장은 그대로, 재시도 가능)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ProvisionSyncResult" } } }
                  ]
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/admin/api/provision/status": {
      "get": {
        "operationId": "getProvisionStatus",
        "summary": "마지막 동기화 상태 (대상별)",
        "tags": ["provision"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/SyncTargets" } } }
                  ]
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "오류 — { success: false, code: ADM-XXXX, message }",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": { "type": "boolean" },
          "code": { "type": "string", "description": "성공 시 OK, 오류 시 ADM-XXXX" },
          "message": { "type": "string", "nullable": true },
          "data": { "nullable": true }
        }
      },
      "LatLng": {
        "type": "object",
        "required": ["lat", "lng"],
        "properties": {
          "lat": { "type": "number", "format": "double" },
          "lng": { "type": "number", "format": "double" }
        }
      },
      "AdminCameraRequest": {
        "type": "object",
        "description": "등록·수정 공용 본문 — Old VCA Add New Camera 폼 + Portal Input Sources 필드 (UV-53). 0.7.0 비호환: 좌표 필드 location{lat,lng} → coordinates (location은 설치 위치 설명 문자열로). projectId 생략 시 기본 프로젝트, code 생략 시 CAM-{ZONE3}-{NNN} 자동, zone 생략 시 name",
        "required": ["name", "rtspUrl", "coordinates"],
        "properties": {
          "projectId": { "type": "string", "nullable": true },
          "code": { "type": "string", "nullable": true, "description": "화면 표시 코드(CAM-BDK-001) — cameraId와 별개" },
          "name": { "type": "string" },
          "ip": { "type": "string", "nullable": true },
          "mac": { "type": "string", "nullable": true },
          "maker": { "type": "string", "nullable": true },
          "model": { "type": "string", "nullable": true },
          "resolution": { "type": "string", "nullable": true },
          "protocol": { "type": "string", "nullable": true, "description": "TCP | UDP" },
          "username": { "type": "string", "nullable": true },
          "password": { "type": "string", "nullable": true, "description": "쓰기 전용 — 응답에 없다. 수정 시 null이면 기존 값 유지. AES-GCM 암호화 저장" },
          "rtspUrl": { "type": "string", "description": "rtsp:// 또는 rtsps:// — 분석·중계 입력 스트림 (민감정보 — Portal 관리자 세션 화면·모듈 내부 채널에만)" },
          "locationId": { "type": "string", "nullable": true, "pattern": "^[a-z0-9-]{1,64}$", "description": "생략 시 등록은 loc-{name 슬러그} 발급, 수정은 기존 값 유지" },
          "zone": { "type": "string", "nullable": true },
          "location": { "type": "string", "nullable": true, "description": "설치 위치 설명" },
          "coordinates": { "$ref": "#/components/schemas/LatLng" },
          "serverId": { "type": "string", "nullable": true },
          "aiFeatures": { "type": "array", "items": { "type": "string" } },
          "thumbnail": { "type": "string", "nullable": true }
        }
      },
      "AdminCamera": {
        "type": "object",
        "description": "status/lastSeenAt/lastChangeAt은 원장이 아니라 모듈 MQTT status 적재값(unknown = 미수신)",
        "required": ["cameraId", "name", "hasCredential", "rtspUrl", "locationId", "zone", "coordinates", "aiFeatures", "status", "createdAt", "updatedAt"],
        "properties": {
          "cameraId": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "projectId": { "type": "string", "nullable": true },
          "code": { "type": "string", "nullable": true },
          "name": { "type": "string" },
          "ip": { "type": "string", "nullable": true },
          "mac": { "type": "string", "nullable": true },
          "maker": { "type": "string", "nullable": true },
          "model": { "type": "string", "nullable": true },
          "resolution": { "type": "string", "nullable": true },
          "protocol": { "type": "string", "nullable": true },
          "username": { "type": "string", "nullable": true },
          "hasCredential": { "type": "boolean", "description": "password 설정 여부 — 평문·암호문 모두 응답에 없다" },
          "rtspUrl": { "type": "string" },
          "locationId": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "zone": { "type": "string" },
          "location": { "type": "string", "nullable": true },
          "coordinates": { "$ref": "#/components/schemas/LatLng" },
          "serverId": { "type": "string", "nullable": true },
          "aiFeatures": { "type": "array", "items": { "type": "string" } },
          "thumbnail": { "type": "string", "nullable": true },
          "status": { "type": "string", "description": "online | offline | error | unknown" },
          "lastSeenAt": { "type": "string", "format": "date-time", "nullable": true },
          "lastChangeAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ProvisionSyncState": {
        "type": "object",
        "required": ["synced"],
        "properties": {
          "lastAttemptAt": { "type": "string", "format": "date-time", "nullable": true },
          "lastSuccessAt": { "type": "string", "format": "date-time", "nullable": true },
          "moduleAccepted": { "type": "integer", "nullable": true, "description": "모듈이 마지막으로 수리한 카메라 수" },
          "lastError": { "type": "string", "nullable": true },
          "synced": { "type": "boolean", "description": "마지막 시도가 성공했고 이후 실패가 없는지" }
        }
      },
      "SyncTargets": {
        "type": "object",
        "description": "동기화 대상별 상태 — module: 분석 모듈 provisioning (계약 v1.9), media: 미디어 서버 스트림 path (v0.2.0, UV-43)",
        "required": ["module", "media"],
        "properties": {
          "module": { "$ref": "#/components/schemas/ProvisionSyncState" },
          "media": { "$ref": "#/components/schemas/ProvisionSyncState" }
        }
      },
      "ProvisionSyncResult": {
        "type": "object",
        "required": ["synced", "module", "media"],
        "properties": {
          "synced": { "type": "boolean", "description": "두 대상 모두 성공했는지" },
          "module": { "$ref": "#/components/schemas/ProvisionSyncState" },
          "media": { "$ref": "#/components/schemas/ProvisionSyncState" }
        }
      }
    }
  }
}
